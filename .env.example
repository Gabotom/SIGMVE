DB_HOST=localhost
DB_PORT=5432
DB_USER=sigmve
DB_PASSWORD=sigmve_pass
DB_NAME=sigmve
JWT_SECRET=cambia_este_secreto
ADMIN_EMAIL=admin@sigmve.cl
ADMIN_PASSWORD=Admin1234
JWT_EXPIRES_IN=8h
# Orígenes permitidos para CORS (Angular / Ionic), separados por coma
CORS_ORIGIN=http://localhost:4200,http://localhost:8100
# Intentos de login permitidos por IP en la ventana (ms). En producción conviene ~5.
THROTTLE_LOGIN_LIMIT=20
THROTTLE_LOGIN_TTL_MS=60000
PORT=3000
# Zona horaria de la operación: define qué día es "hoy" (mantenciones vencidas) y el horario del cron
APP_TIMEZONE=America/Santiago
# Módulo 5 · Alertas. Expresión cron de la evaluación periódica ("off" la desactiva)
ALERTS_CRON=*/10 * * * *
# Avisar mantenciones programadas dentro de estos días
ALERT_UPCOMING_DAYS=7
# Una mantención vencida pasa a crítica después de estos días de atraso
ALERT_OVERDUE_CRITICAL_DAYS=7
# Horas que una incidencia no crítica puede seguir abierta sin mantención antes de alertar
ALERT_INCIDENT_STALE_HOURS=24
# % mínimo de la flota disponible; bajo este valor hay alerta crítica
ALERT_MIN_AVAILABILITY_PCT=70
